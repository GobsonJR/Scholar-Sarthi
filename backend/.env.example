# Copy this file to .env and adjust as needed. All values below are safe
# demo defaults — no paid API keys are required to run the application.

# Secret used to sign JWT access tokens. Change this in any real deployment.
JWT_SECRET_KEY=demo-super-secret-key-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# SQLite is used for local development by default. For production, point
# this at PostgreSQL instead — same SQLAlchemy models, same application
# code, no code changes required:
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/scholarship
# (psycopg v3, not the legacy psycopg2 — see requirements.txt.) Either way,
# run `alembic upgrade head` before starting the app or running the seed —
# see README "Database & migrations" for the full workflow. Never commit a
# real production URL/password here; this file is the template, not the
# real .env.
DATABASE_URL=sqlite:///./scholarship.db

# Directory where uploaded documents are stored on disk.
UPLOAD_DIR=./uploads

# Comma separated list of origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional (future): if set, the AI router can be extended to call a real
# OCR/LLM provider instead of the deterministic demo pipeline. Not required.
# EXTERNAL_AI_API_KEY=

# Where PaddleOCR / LayoutLMv3 cache downloaded model weights (~100MB +
# ~500MB respectively, downloaded once). Point this at a volume with free
# space if your system drive is tight — it does not need to live inside the
# project directory.
MODEL_CACHE_DIR=./models

# PaddlePaddle auto-detects CUDA; this only controls whether GPU inference is
# requested at all. The pipeline runs correctly on CPU either way.
USE_GPU=false

# LayoutLMv3 document-understanding (Phase 5). If disabled, or if the model
# fails to load for any reason, document-type classification falls back to
# the Phase 4 OCR-keyword/filename classifier automatically — the app keeps
# working either way, just without the LayoutLMv3 signal.
LAYOUTLM_ENABLED=true
LAYOUTLM_MODEL_NAME=microsoft/layoutlmv3-base

# IndicTrans2 multilingual OCR-text normalization (Phase 6). The checkpoint
# below is GATED on Hugging Face — you must (1) log into a free HF account,
# (2) visit https://huggingface.co/ai4bharat/indictrans2-indic-en-dist-200M
# and click "Agree and access repository" (instant, no waiting), then
# (3) generate a read-only token at https://huggingface.co/settings/tokens
# and set it below. Never commit a real token — this file is the template,
# not the real .env. If disabled or the token/model is unavailable,
# non-English documents fall back to the existing English-only pipeline
# with the original OCR text preserved — the app keeps working either way.
INDICTRANS_ENABLED=true
INDICTRANS_MODEL_NAME=ai4bharat/indictrans2-indic-en-dist-200M
# HF_TOKEN=

# Enables POST /demo/reset (officer-authenticated), which drops and re-seeds
# the database back to the exact SIH demo state. Set to false to disable the
# endpoint entirely in any deployment where this would be unsafe.
DEMO_MODE=true
